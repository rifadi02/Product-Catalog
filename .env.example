# Copy to .env and adjust. `.env` is git-ignored; this file is committed.
#
#   cp .env.example .env
#   docker compose up --build

# ── Required ─────────────────────────────────────────────────────────────────
# HS256 needs at least 32 bytes. Generate a real one rather than using this value:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-with-at-least-32-bytes-of-random-data

# ── Optional (defaults shown) ────────────────────────────────────────────────
JWT_ISSUER=product-catalog-api
JWT_AUDIENCE=product-catalog-spa

POSTGRES_DB=catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8080
SPA_ORIGIN=http://localhost:5173

# Where the SPA container publishes. Keep this in step with SPA_ORIGIN above: the API allowlists
# that exact origin, and a mismatch fails every request in CORS preflight.
WEB_PORT=5173

# Baked into the SPA bundle at image build time, and resolved by the browser rather than by the
# web container — so it must be host-reachable. Change it only if API_PORT changes too.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── Deploy only (docker-compose.deploy.yml) ──────────────────────────────────

# Which published images to run. The CI/CD pipeline sets these itself (IMAGE_TAG is the commit
# SHA); set them here only to run the deploy stack by hand.
#   REGISTRY=ghcr.io
#   BACKEND_IMAGE=owner/repo/catalog-api
#   FRONTEND_IMAGE=owner/repo/catalog-web
IMAGE_TAG=latest
