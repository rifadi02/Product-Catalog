# Copy to .env. `.env` is git-ignored by the repository root rule; this file is committed.
#
#   cp .env.example .env
#   npm run dev
#
# Versioning is by URL segment, so the version belongs in the base URL (PDR §0.2).
# Health endpoints are NOT versioned and sit outside this base:
#   http://localhost:8080/health/live, http://localhost:8080/health/ready
VITE_API_BASE_URL=http://localhost:8080/api/v1
