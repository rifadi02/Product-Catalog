{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=catalog;Username=postgres;Password=postgres;Include Error Detail=true"
  },

  "Redis": {
    "//": "Leave blank to fall back to in-process caching. Both sit behind the same ICacheService.",
    "Connection": ""
  },

  "Jwt": {
    "Issuer": "product-catalog-api",
    "Audience": "product-catalog-spa",
    "//SigningKey": "NEVER committed. Supply via dotnet user-secrets locally, or Jwt__SigningKey in the environment.",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },

  "Database": {
    "MigrateOnStartup": false
  },

  "Seed": {
    "Enabled": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName" ]
  },

  "AllowedHosts": "*"
}
